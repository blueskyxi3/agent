AGENT_HOST=0.0.0.0
AGENT_PORT=3100
# process 包由启动器自动设置；external 模式需与市场登记的插件版本一致。
AGENT_PLUGIN_VERSION=1.0.0
AIHUB_INTERNAL_URL=http://ai-hub:3000
AGENT_HOST_SECRET=replace-with-the-plugin-registration-secret-at-least-32-chars
AGENT_DATA_DIR=/data/agent
AGENT_SQLITE_PATH=/data/agent/agent.sqlite
AGENT_ASSETS_DIR=/app/apps/web/dist

# 模型、推理等级和语音开关只读取当前用户的个人设置。

AGENT_MODEL_IMAGE_INPUT=true
AGENT_MODEL_CONTEXT_WINDOW=128000
AGENT_MODEL_MAX_TOKENS=8192
AGENT_REQUEST_TIMEOUT_MS=60000
# AGENT_ALLOWED_ORIGINS=https://ai-hub.example.com
