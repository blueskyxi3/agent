{
  "manifest": {
    "id": "agent",
    "name": "智能助手",
    "version": "1.0.0",
    "sdk_version": 2,
    "extensions": ["site.global.layer"],
    "entry": "/assets/plugin.js",
    "backend": "agent"
  },
  "description": "全站智能助手，使用当前用户的模型选择和权限。",
  "logo": "https://raw.githubusercontent.com/blueskyxi3/agent/main/plugin-logos/agent.png",
  "background": "https://raw.githubusercontent.com/blueskyxi3/agent/main/plugin-backgrounds/agent.png",
  "modes": ["process", "external", "kubernetes"],
  "artifacts": {
    "darwin-arm64": "https://github.com/blueskyxi3/agent/releases/download/1.0.0/agent-1.0.0-darwin-arm64.zip",
    "linux-amd64": "https://github.com/blueskyxi3/agent/releases/download/1.0.0/agent-1.0.0-linux-amd64.zip",
    "linux-arm64": "https://github.com/blueskyxi3/agent/releases/download/1.0.0/agent-1.0.0-linux-arm64.zip"
  },
  "trial_days": 7,
  "purchase_days": 0,
  "env_prefix": "AGENT",
  "external_url": "",
  "secret_env": "AGENT_HOST_SECRET",
  "rollback_compatible": false
}
